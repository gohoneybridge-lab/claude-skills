# core.security_basics — commit THIS file, never a real .env / .env.local.
# The anon key is safe for the browser; Row Level Security is the real gate.
# The service-role key (if you ever add one) is SERVER-ONLY — never prefix it
# with NEXT_PUBLIC_ and never expose it to the client.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SUPABASE_SERVICE_ROLE_KEY=server-only-never-public
